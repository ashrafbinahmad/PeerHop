<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- ===================== PACKAGE ===================== -->
  <Package
    Name="PeerHop"
    Version="2.3.7"
    Manufacturer="Muhammed Ashraf"
    UpgradeCode="12345678-1234-1234-1234-123456789ABC"
    Language="1033"
    InstallerVersion="500"
    Compressed="yes"
    Scope="perMachine">

    <SummaryInformation
      Description="PeerHop Installer"
      Comments="Fast and secure file transfer application"
      Manufacturer="Muhammed Ashraf" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of PeerHop is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- ===================== FEATURES ===================== -->
    <Feature Id="ProductFeature"
             Title="PeerHop Application"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuComponent" />
    </Feature>

    <Feature Id="DesktopShortcutFeature"
             Title="Create Desktop Shortcut"
             Level="1">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <!-- ===================== UI ===================== -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!-- ===================== ARP ===================== -->
    <Icon Id="PeerHopIcon" SourceFile="..\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="PeerHopIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ashrafbinahmad/peerhop" />

  </Package>

  <!-- ===================== DIRECTORIES + COMPONENTS ===================== -->
  <Fragment>

    <!-- Install folder -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PeerHop" />
    </StandardDirectory>

    <!-- Start Menu -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="PeerHop">

        <Component Id="StartMenuComponent"
                   Guid="11111111-1111-1111-1111-111111111111">

          <Shortcut
            Id="StartMenuShortcut"
            Name="PeerHop"
            Description="Fast and secure file transfer"
            Target="[INSTALLFOLDER]PeerHop.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="PeerHopIcon" />

          <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />

          <RegistryValue
            Root="HKLM"
            Key="Software\PeerHop"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />

        </Component>

      </Directory>
    </StandardDirectory>

    <!-- Desktop -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent"
                 Guid="22222222-2222-2222-2222-222222222222">

        <Shortcut
          Id="DesktopShortcut"
          Name="PeerHop"
          Description="Fast and secure file transfer"
          Target="[INSTALLFOLDER]PeerHop.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="PeerHopIcon" />

        <RemoveFolder Id="RemoveDesktopShortcut" On="uninstall" />

        <RegistryValue
          Root="HKLM"
          Key="Software\PeerHop"
          Name="desktop_shortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />

      </Component>
    </StandardDirectory>

  </Fragment>

  <!-- ===================== FILE COMPONENTS ===================== -->
  <Fragment>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable"
                 Guid="87654321-4321-4321-4321-CBA987654321">

        <File Id="PeerHopEXE"
              Source="..\..\bin\PeerHop.exe"
              KeyPath="yes"
              Checksum="yes" />

      </Component>
    </ComponentGroup>

  </Fragment>

</Wix>
