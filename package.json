{
  "name": "transend-root",
  "version": "1.0.0",
  "description": "Root package for Transend build scripts",
  "scripts": {
    "build:win": "cd ui && wails build -platform windows/amd64 -o ../transend_win.exe",
    "build:win:nsis": "cd ui && wails build -platform windows/amd64 -nsis",
    "build:linux": "cd ui && wails build -platform linux/amd64 -o ../transend_linux",
    "build:cli:win": "go build -o transend_cli_win.exe ./cmd/transend",
    "build:cli:linux": "set GOOS=linux&& go build -o transend_cli_linux ./cmd/transend",
    "dev:cli": "go run ./cmd/transend",
    "dev:ui": "cd ui && wails dev",
    "dev:receiver": "go run ./cmd/transend -r"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
